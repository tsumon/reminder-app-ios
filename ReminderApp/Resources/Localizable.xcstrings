    "列出所有提醒，查看当前有哪些提醒。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出所有提醒，查看当前有哪些提醒。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List all reminders and see what is currently set."
          }
        },
        "zh-Hant": {
