    "WebDAV 地址无效。示例：https://dav.jianguoyun.com/dav/（坚果云必须以 /dav/ 结尾）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WebDAV 地址无效。示例：https://dav.jianguoyun.com/dav/（坚果云必须以 /dav/ 结尾）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid WebDAV URL. Example: https://dav.jianguoyun.com/dav/ (Jianguoyun must end with /dav/)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WebDAV 地址無效。範例：https://dav.jianguoyun.com/dav/（堅果雲必須以 /dav/ 結尾）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WebDAV URL が無効です。例：https://dav.jianguoyun.com/dav/（Jianguoyun は /dav/ で終わる必要があります）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WebDAV 주소가 잘못됨. 예: https://dav.jianguoyun.com/dav/ (너트클라우드는 /dav/ 로 끝나야 함)"
          }
        }
      }
    },
